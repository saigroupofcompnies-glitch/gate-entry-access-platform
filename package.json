{
  "name": "gate-entry-access-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Examination Identity, Access & Live Centre Management — SRS v1.0 MVP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
